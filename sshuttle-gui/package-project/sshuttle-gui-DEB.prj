[NAME]
name=sshuttle-gui

[VERSION]
version=0.5

[RELEASE]
release=0.mrx10

[GROUP]
group=Networking/Other

[DESCRIPTION]
0=GUI for SShuttle - Transparent proxy server that works as a poor man's VPN. Forwards over ssh.
1=---
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2026

[SUMMARY]
summary=GUI for SShuttle

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/SShuttle-GUI

[LICENSE]
license=GPL-3.0-or-later

[DEPS]
deps=sshuttle sshpass iptables fping systemd libgtk2.0-0

[META]
meta=0

[NOARCH]
noarch=0

[DEB]
deb=1

[FILES]
0=/usr/bin/sshuttle-gui
1=/usr/share/icons/sshuttle-gui.png
2=/etc/systemd/system/sshuttle.service
3=/usr/share/applications/sshuttle-gui.desktop
4=/usr/share/polkit-1/actions/sshuttle-gui.policy
5=/usr/share/sshuttle-gui/
6=/usr/share/doc/sshuttle-gui/

[AFTERINSTALL]
0=systemctl daemon-reload

[AFTERREMOVE]
0=systemctl daemon-reload

[URL32]
url32=https://github.com/AKotov-dev/SShuttle-GUI

[PROGRAMNAME]
programname=SShuttle-GUI

[DEVTOOL]
devtool=Lazarus

[TOOLVERSION]
toolversion=4.4

[INFO]
0=v0.5
1=+ Implement anchor-based UI layout
2=+ Improved /etc/systemd/system/sshuttle.service
3=+ Improved cleanup of keys in ~/.ssh/known_hosts
4=+ RPM/DEB packages for Mageia/Fedora/Ubuntu/Debian
5=
6=**Note:** Tested on Mageia Plasma X11/Wayland with various scaling settings.
7=
8=v0.4
9=+ Build in Lazarus-4.4
10=+ RPM/DEB packages for Mageia/Fedora/Ubuntu
11=
12=v0.3
13=+ Recompiling in Lazarus 3.2
14=+ Force iptables nat clear if sshuttle.service is stopped
15=+ Re-creating SSH keys (when there are changes on the server)
16=+ RPM-packages for Mageia-9 and Ubuntu
17=
18=v0.2
19=+ Improved startup sshuttle.service
20=+ RPM-packages for Mageia-8, ROSA Linux and Mageia-9
21=
22=v0.1 - initial release
